# ============================================================================
# LangChain EvalTask Server v2.0 — Variables d'environnement
# Copiez ce fichier en .env et adaptez les valeurs.
# ============================================================================

# --- Serveur ---
APP_NAME="LangChain EvalTask Server"
APP_VERSION=2.0.0
PORT=8000
DEBUG=false
HOST=0.0.0.0
ALLOWED_ORIGINS=https://client-a.evaltask.com,https://client-b.evaltask.com

# --- JWT (secret partagé avec les plateformes EvalTask) ---
JWT_SECRET=change-me-in-production-with-a-strong-random-key!
JWT_ALGORITHM=HS256
JWT_EXPIRY_LEEWAY_SECONDS=30

# --- OpenRouter (clé par défaut, chaque tenant envoie sa propre clé) ---
OPENROUTER_DEFAULT_MODEL=z-ai/glm-5.2
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2

# --- Embeddings (endpoint dédié, séparé du LLM) ---
EMBEDDING_PROVIDER_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_MAX_RESULTS=5

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0
CONVERSATION_TTL_SECONDS=3600
CONVERSATION_MAX_MESSAGES=50

# --- Cache de réponses LLM ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600

# --- Limites LLM ---
MAX_TOOL_ROUNDS=5
MAX_TOKENS=4096
TEMPERATURE=0.7

# --- Qualité conversation ---
SUMMARY_THRESHOLD_MESSAGES=10
SUMMARY_KEEP_RECENT_MESSAGES=4
INTENT_DETECTION_ENABLED=true

# --- Rate limiting par tenant ---
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_EMBED_PER_MINUTE=10
RATE_LIMIT_TOKENS_PER_DAY=500000

# --- Gestion des clés API ---
# Si true, les clés OpenRouter sont stockées côté serveur (chiffrées Redis)
# Les tenants les enregistrent via POST /api/v1/keys
# Si false, fallback sur la clé envoyée dans chaque requête (rétrocompatibilité)
API_KEY_SERVER_MANAGED=true

# --- Budget & coût ---
BUDGET_ALERT_THRESHOLD_USD=10.0
TENANT_BUDGET_DEFAULT_USD=50.0
COST_TRACKING_ENABLED=true

# --- Observabilité ---
LOG_LEVEL=INFO
LOG_FORMAT=text
TRACE_SAMPLING_RATE=1.0
METRICS_ENABLED=true

# --- Circuit breaker ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# --- Sécurité ---
MAX_INPUT_LENGTH=10000
MAX_HISTORY_MESSAGES=30
