# Copier vers deploy/.env sur le VPS puis chmod 600 deploy/.env.
# Ne jamais commiter ce fichier avec des valeurs réelles.

DOMAIN=langchain.example.com
ACME_EMAIL=admin@example.com
APP_VERSION=2.0.0
DEBUG=false

# URL(s) exacte(s) des plateformes autorisées, séparées par des virgules.
ALLOWED_ORIGINS=https://app.example.com

# Générer avec : openssl rand -hex 32
JWT_SECRET=REPLACE_ME
# Générer avec : openssl rand -hex 32
REDIS_PASSWORD=REPLACE_ME_WITH_RANDOM_REDIS_SECRET

OPENROUTER_DEFAULT_MODEL=z-ai/glm-5.2
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
EMBEDDING_PROVIDER_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
REDIS_MAXMEMORY=256mb
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0
CONVERSATION_TTL_SECONDS=3600
CONVERSATION_MAX_MESSAGES=50
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
MAX_TOOL_ROUNDS=5
MAX_TOKENS=4096
TEMPERATURE=0.7
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_EMBED_PER_MINUTE=10
RATE_LIMIT_TOKENS_PER_DAY=500000
API_KEY_SERVER_MANAGED=true
BUDGET_ALERT_THRESHOLD_USD=10.0
TENANT_BUDGET_DEFAULT_USD=50.0
COST_TRACKING_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
TRACE_SAMPLING_RATE=0.1
METRICS_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
MAX_INPUT_LENGTH=10000
MAX_HISTORY_MESSAGES=30
